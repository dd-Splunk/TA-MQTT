      }
    ],
    "releaseDate": "2026-07-11",
    "description": "Multi-broker MQTT add-on for Splunk. Supports anonymous access, username/password, plain TLS, and mutual TLS (mTLS) with optional client certificates and CA pinning.",
    "classification": {
      "intendedAudience": "Splunk administrators and IoT platform operators",
      "categories": [
        "IoT",
        "IT Operations"
      ],
      "developmentStatus": "Beta"
    },
    "commonInformationModels": [
      {
        "name": "Interprocess Messaging",
        "version": "6.1.0"
      },
      {
        "name": "Network Traffic",
        "version": "6.1.0"
      }
    ],
    "license": {
      "name": "Apache-2.0",
      "uri": "https://www.apache.org/licenses/LICENSE-2.0"
    },
    "privacyPolicy": {
      "name": "",
      "url": null
    },
    "releaseNotes": "* HEC event model: JSON MQTT bodies indexed as _raw (KV_MODE=json); envelope metadata in HEC fields.\n* CIM envelope fields at ingest (src, dvc, app, action, transport) plus FIELDALIAS dest/dest_port and topic EXTRACT fallbacks.\n* Search view shows CIM and telemetry columns; transforms.conf added for topic parsing."
  },
