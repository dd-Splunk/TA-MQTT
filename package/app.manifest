  "info": {
    "title": "MQTT Broker Add-on for Splunk",
    "id": {
      "group": null,
      "name": "TA-MQTT",
      "version": "2.4.2"
    },
    "author": [
      {
        "name": "Dominique Dessy",
        "email": "dodessy@cisco.com",
