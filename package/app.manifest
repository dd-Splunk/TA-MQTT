    ],
    "releaseDate": "2026-07-10",
    "description": "Multi-broker MQTT add-on for Splunk. Supports anonymous access, username/password, plain TLS, and mutual TLS (mTLS) with optional client certificates and CA pinning.",
    "classification": {
      "intendedAudience": "Splunk administrators and IoT platform operators",
      "categories": [
        "IoT",
        "IT Operations"
      ],
      "developmentStatus": "Beta"
    },
    "commonInformationModels": null,
    "license": {
      "name": "Apache-2.0",
      "uri": "https://www.apache.org/licenses/LICENSE-2.0"
    },
    "privacyPolicy": {
      "name": "",
      "url": null
    },
    "releaseNotes": "* Broker TLS/mTLS fields are exposed in Configuration → Broker Connections (use_tls, CA/client PEM, skip_verify gated by Security → Allow insecure TLS).\n* Monitoring dashboard uses one global time picker for all panels (60s auto-refresh).\n* Search view lists mqtt:message events."
  },
  "dependencies": null,
  "tasks": null,
  "inputGroups": null,
  "incompatibleApps": null,
  "platformRequirements": null,
  "supportedDeployments": [
    "_standalone",
    "_distributed"
  ],
  "targetWorkloads": [
    "_search_heads",
    "_indexers"
  ]
}
