SPLUNK_PASSWORD=changeme

# Splunk OT Intelligence (Splunkbase app 5180) — session token via api/account:login
# (same flow as splunk/splunk docker). Not HTTP basic auth on the download URL.
SPLUNKBASE_USERNAME=
SPLUNKBASE_PASSWORD=
# Optional: paste <id> token from Splunkbase login API, or browser session cookies (MFA accounts).
# SPLUNKBASE_AUTH_TOKEN=
# SPLUNKBASE_SID=
# SPLUNKBASE_SSOID=

# Optional: install from a local package instead of Splunkbase download.
# Place the file at tools/splunk-apps/splunk-ot-intelligence-4.13.2.tgz
# SPLUNK_OTI_APPS_URL=/tmp/splunk-apps/splunk-ot-intelligence-4.13.2.tgz
