                                "label": "HEC Flush Interval"
                            },
                            {
                                "field": "hec_retry_max_attempts",
                                "label": "HEC Retry Attempts"
                            },
                            {
                                "field": "hec_retry_backoff_ms",
                                "label": "HEC Retry Backoff"
                            }
                        ],
                        "actions": [
                            "edit",
                            "delete",
                            "clone"
                        ]
                    }
                }
            ]
        }
    }
}
