                                "label": "Verify HEC TLS"
                            },
                            {
                                "field": "hec_batch_max_events",
                                "label": "HEC Max Events"
                            },
                            {
                                "field": "hec_batch_max_bytes",
                                "label": "HEC Max Bytes"
                            },
                            {
